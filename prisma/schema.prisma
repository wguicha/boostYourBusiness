// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role definition for users within a business
enum Role {
  OWNER
  EMPLOYEE
}

// Status for invitations
enum InvitationStatus {
  PENDING
  ACCEPTED
}

enum ProductType {
  PRINCIPAL
  BEBIDA
  ACOMPANAMIENTO
}

// Business model
model Business {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation to users (many-to-many)
  users     BusinessUser[]
  // Relation to products (one-to-many)
  products  Product[]
  // Relation to sales (one-to-many)
  sales     Sale[]
  // Relation to combos (one-to-many)
  combos    Combo[]
}

// Join table for the many-to-many relationship between Business and User
model BusinessUser {
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @default(OWNER)
  status     InvitationStatus @default(ACCEPTED)

  assignedAt DateTime @default(now())
  assignedBy String? // Optional: to track who assigned the user

  @@id([businessId, userId])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Decimal
  quantity    Int
  imageUrl    String?
  type        ProductType @default(PRINCIPAL)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  SaleItem SaleItem[]

  // Relation to a Business (now required)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Relation to Combos
  combos ComboProduct[]
}

model Combo {
  id          String   @id @default(cuid())
  name        String
  price       Decimal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relation to Business (now required)
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Relation to products in the combo
  products    ComboProduct[]

  // Relation to sale items
  SaleItem    SaleItem[]
}

model ComboProduct {
  id        String @id @default(cuid())
  quantity  Int

  // Relation to Combo
  comboId   String
  combo     Combo  @relation(fields: [comboId], references: [id], onDelete: Cascade)

  // Relation to Product
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([comboId, productId])
}

model Sale {
  id            String   @id @default(cuid())
  totalAmount   Decimal
  paymentMethod String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         SaleItem[]

  // ADDED: Relation to a Business (now required)
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model SaleItem {
  id          String  @id @default(cuid())
  quantity    Int
  priceAtSale Decimal

  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  // An item can be either a product or a combo
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  comboId   String?
  combo     Combo?   @relation(fields: [comboId], references: [id], onDelete: Restrict)
}

// NextAuth.js models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  // REMOVED: businessName is no longer needed here
  // businessName  String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?
  image         String?
  passwordResetToken          String?
  passwordResetTokenExpires   DateTime?

  accounts Account[]
  sessions Session[]

  // ADDED: Relation to businesses (many-to-many)
  businesses BusinessUser[]
}

model VerificationToken {
  identifier String   @id @default(cuid())
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}